# Core
APP_ENV=production
APP_DEBUG=false
APP_SECRET_KEY=
JWT_SECRET_KEY=
ADMIN_EMAIL=
ADMIN_PASSWORD=
ALLOWED_ORIGINS=["https://your-dashboard-domain"]
DASHBOARD_BASE_URL=https://your-dashboard-domain

# Data and AI
MONGO_URI=
MONGO_DB=arguscx_logs
DATABASE_URL=
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
GROQ_API_KEY=
GROQ_MODEL=

# Provider connectors (supply only what your workflow uses)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
STRIPE_SECRET_KEY=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Object storage for customer evidence
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_SECURE=true

# Human handoff email. Use a transaction-mail provider or your company SMTP.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SUPPORT_HANDOFF_EMAIL=

# Optional signed webhook into Zendesk, Freshdesk, Salesforce, or your own desk.
HUMAN_HANDOFF_WEBHOOK_URL=
HUMAN_HANDOFF_WEBHOOK_SECRET=
