# ============================================================
#  ArgusCX — Environment Variables Template
#  Copy this file to .env and fill in your values.
#  NEVER commit .env to version control.
# ============================================================

# ─────────────────────────────────────────────
#  APP CORE
# ─────────────────────────────────────────────
APP_NAME=ArgusCX
APP_ENV=development               # development | staging | production
APP_PORT=8000
APP_SECRET_KEY=your-super-secret-key-change-this-in-production
APP_DEBUG=true
APP_VERSION=0.1.0
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# ─────────────────────────────────────────────
#  FRONTEND (Next.js)
# ─────────────────────────────────────────────
NEXT_PUBLIC_APP_NAME=ArgusCX
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
NEXT_PUBLIC_APP_VERSION=0.1.0
NEXT_PUBLIC_DEMO_MODE=true          # Set false when real LLM keys are available

# ─────────────────────────────────────────────
#  AUTHENTICATION & SECURITY
# ─────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-min-32-chars
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
OAUTH2_CLIENT_ID=your-oauth2-client-id
OAUTH2_CLIENT_SECRET=your-oauth2-client-secret

# ─────────────────────────────────────────────
#  AI / LLM LAYER
# ─────────────────────────────────────────────

# OpenAI (Primary LLM)
OPENAI_API_KEY=sk-your-openai-api-key
OPENAI_ORG_ID=org-your-org-id
OPENAI_MODEL=gpt-4o                 # gpt-4o | gpt-4-turbo | gpt-3.5-turbo
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_TOKENS=4096
OPENAI_TEMPERATURE=0.2

# Anthropic (Fallback LLM)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key
ANTHROPIC_MODEL=claude-opus-4-5

# Azure OpenAI (Enterprise / Sponsor stack)
AZURE_OPENAI_API_KEY=your-azure-openai-key
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
AZURE_OPENAI_API_VERSION=2024-02-01
AZURE_OPENAI_DEPLOYMENT_NAME=gpt-4o
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Azure AI Foundry / AI Services
AZURE_AI_SERVICES_KEY=your-azure-ai-services-key
AZURE_AI_SERVICES_ENDPOINT=https://your-ai-services.cognitiveservices.azure.com/
AZURE_SUBSCRIPTION_ID=your-azure-subscription-id
AZURE_RESOURCE_GROUP=arguscx-rg
AZURE_AI_PROJECT_NAME=arguscx-ai

# Azure AI Vision (Multimodal / Evidence Verification)
AZURE_VISION_API_KEY=your-azure-vision-key
AZURE_VISION_ENDPOINT=https://your-vision.cognitiveservices.azure.com/

# Ollama (Local LLM — Free, no API key needed)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2               # llama3.2 | mistral | gemma2

# LangSmith (LangGraph observability & tracing)
LANGCHAIN_API_KEY=ls__your-langsmith-api-key
LANGCHAIN_PROJECT=arguscx
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com

# ─────────────────────────────────────────────
#  AGENT FRAMEWORK CONFIG
# ─────────────────────────────────────────────
AGENT_MAX_ITERATIONS=10
AGENT_TIMEOUT_SECONDS=60
AGENT_CONFIDENCE_THRESHOLD=0.75       # Below this → escalate to human
AGENT_FRAUD_RISK_THRESHOLD=0.65       # Above this → flag for review
AGENT_AUTO_RESOLVE_THRESHOLD=0.85     # Above this → auto-resolve
ORCHESTRATOR_MODEL=gpt-4o
SPECIALIST_MODEL=gpt-4o-mini          # Cost-efficient for specialist agents

# ─────────────────────────────────────────────
#  DATA LAYER
# ─────────────────────────────────────────────

# PostgreSQL (Primary DB — Operational Database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=arguscx
POSTGRES_USER=arguscx_user
POSTGRES_PASSWORD=your-postgres-password
DATABASE_URL=postgresql+asyncpg://arguscx_user:your-postgres-password@localhost:5432/arguscx
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# MongoDB (Conversations & Logs)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=arguscx_logs
MONGO_USER=arguscx_mongo_user
MONGO_PASSWORD=your-mongo-password
MONGO_AUTH_SOURCE=admin

# Redis (Cache, Session, Queue)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your-redis-password
REDIS_DB=0
REDIS_URL=redis://:your-redis-password@localhost:6379/0

# ─────────────────────────────────────────────
#  VECTOR DATABASE (RAG)
# ─────────────────────────────────────────────

# Pinecone (Cloud Vector DB)
PINECONE_API_KEY=your-pinecone-api-key
PINECONE_ENVIRONMENT=gcp-starter     # or us-east-1-aws
PINECONE_INDEX_NAME=arguscx-knowledge
PINECONE_DIMENSION=1536              # Matches OpenAI text-embedding-3-small

# Azure AI Search (Alternative vector store — sponsor stack)
AZURE_SEARCH_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_API_KEY=your-azure-search-admin-key
AZURE_SEARCH_INDEX_NAME=arguscx-rag

# ChromaDB (Local fallback vector store — zero setup)
CHROMA_HOST=localhost
CHROMA_PORT=8001
CHROMA_COLLECTION=arguscx_knowledge

# ─────────────────────────────────────────────
#  FILE / BLOB STORAGE
# ─────────────────────────────────────────────

# AWS S3 (Evidence / Document storage)
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_REGION=ap-south-1
AWS_S3_BUCKET_NAME=arguscx-evidence
AWS_S3_ENDPOINT_URL=                 # Leave blank for real AWS; set for MinIO local

# Azure Blob Storage (Alternative)
AZURE_STORAGE_ACCOUNT_NAME=arguscxstorage
AZURE_STORAGE_ACCOUNT_KEY=your-azure-storage-key
AZURE_STORAGE_CONTAINER=evidence

# MinIO (Local S3-compatible storage — for dev)
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_access_key
MINIO_SECRET_KEY=minio_secret_key
MINIO_BUCKET=arguscx-evidence
MINIO_SECURE=false

# ─────────────────────────────────────────────
#  EXTERNAL INTEGRATIONS
# ─────────────────────────────────────────────

# Shopify (Order Management)
SHOPIFY_API_KEY=your-shopify-api-key
SHOPIFY_API_SECRET=your-shopify-api-secret
SHOPIFY_ACCESS_TOKEN=shpat_your-token
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2024-01

# Stripe (Payment Gateway)
STRIPE_SECRET_KEY=sk_test_your-stripe-secret-key
STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-publishable-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Razorpay (India — Alternative payment gateway)
RAZORPAY_KEY_ID=rzp_test_your-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Slack (Internal Alerts & Collaboration)
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_SIGNING_SECRET=your-slack-signing-secret
SLACK_CHANNEL_ID=C0XXXXXXXXX          # #support-alerts channel
SLACK_ESCALATION_CHANNEL=C0YYYYYYYYY  # #escalations channel
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/your/webhook/url

# Zendesk (Ticketing System)
ZENDESK_SUBDOMAIN=your-subdomain
ZENDESK_API_TOKEN=your-zendesk-api-token
ZENDESK_EMAIL=support@yourdomain.com

# HubSpot (CRM — Alternative)
HUBSPOT_API_KEY=your-hubspot-api-key
HUBSPOT_PORTAL_ID=your-portal-id

# Salesforce (CRM — Enterprise)
SALESFORCE_USERNAME=your-sf-username
SALESFORCE_PASSWORD=your-sf-password
SALESFORCE_SECURITY_TOKEN=your-sf-security-token
SALESFORCE_DOMAIN=login               # login | test

# Twilio (SMS / WhatsApp / Voice)
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-auth-token
TWILIO_PHONE_NUMBER=+1234567890
TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886

# SendGrid (Email)
SENDGRID_API_KEY=SG.your-sendgrid-api-key
SENDGRID_FROM_EMAIL=support@arguscx.ai
SENDGRID_FROM_NAME=ArgusCX Support

# ─────────────────────────────────────────────
#  MONITORING & OBSERVABILITY
# ─────────────────────────────────────────────

# Sentry (Error Tracking)
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0.1

# Grafana (Visualization)
GRAFANA_URL=http://localhost:3001
GRAFANA_API_KEY=your-grafana-api-key
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=your-grafana-password

# Prometheus (Metrics)
PROMETHEUS_PORT=9090
PROMETHEUS_SCRAPE_INTERVAL=15s
METRICS_ENABLED=true

# DataDog (APM — Enterprise alternative)
DATADOG_API_KEY=your-datadog-api-key
DATADOG_APP_KEY=your-datadog-app-key
DATADOG_SITE=datadoghq.com

# ─────────────────────────────────────────────
#  DEPLOYMENT & DEVOPS
# ─────────────────────────────────────────────

# AWS (Cloud Platform)
AWS_DEFAULT_REGION=ap-south-1
AWS_ECS_CLUSTER=arguscx-cluster
AWS_ECR_REGISTRY=your-account-id.dkr.ecr.ap-south-1.amazonaws.com

# Kubernetes
K8S_NAMESPACE=arguscx
K8S_CONTEXT=your-k8s-context

# Docker
DOCKER_REGISTRY=ghcr.io/your-org/arguscx
DOCKER_IMAGE_TAG=latest

# GitHub Actions CI/CD
GH_TOKEN=ghp_your-github-pat
GITHUB_REPO=your-org/arguscx

# ─────────────────────────────────────────────
#  FRAUD DETECTION & EVIDENCE ANALYSIS
# ─────────────────────────────────────────────
C2PA_VERIFICATION_ENABLED=true
EXIF_CHECK_ENABLED=true
AI_ARTIFACT_DETECTION_ENABLED=true
HIVE_API_KEY=your-hive-moderation-api-key    # AI-generated image detection
SIGHTENGINE_API_USER=your-sightengine-user   # Alternative image forensics
SIGHTENGINE_API_SECRET=your-sightengine-secret

# ─────────────────────────────────────────────
#  RATE LIMITING & QUEUE
# ─────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
CELERY_BROKER_URL=redis://:your-redis-password@localhost:6379/1
CELERY_RESULT_BACKEND=redis://:your-redis-password@localhost:6379/2

# ─────────────────────────────────────────────
#  LOGGING
# ─────────────────────────────────────────────
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_FORMAT=json                       # json | text
LOG_FILE=logs/arguscx.log
AUDIT_LOG_ENABLED=true

# ─────────────────────────────────────────────
#  FEATURE FLAGS
# ─────────────────────────────────────────────
FEATURE_MULTIMODAL_ENABLED=true
FEATURE_VOICE_CHANNEL_ENABLED=false   # Phase 2
FEATURE_ANALYTICS_ENABLED=true
FEATURE_FRAUD_DETECTION_ENABLED=true
FEATURE_AUTO_RESOLVE_ENABLED=true
FEATURE_HUMAN_LOOP_ENABLED=true
FEATURE_PREDICTIVE_CHURN_ENABLED=false # Phase 2
